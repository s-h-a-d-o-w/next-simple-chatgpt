{
  "name": "next-simple-chatgpt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "next experimental-analyze",
    "beforebuild": "pnpm generate:refractor-languages && node ./scripts/generateBuildTimestamp.ts",
    "build": "pnpm beforebuild && next build && pnpm afterbuild",
    "build:e2e": "pnpm beforebuild && cross-env NEXT_PUBLIC_TEST=true next build && pnpm afterbuild",
    "afterbuild": "shx cp -r public .next/standalone/public && shx cp -r .next/static .next/standalone/.next/static",
    "predev": "pnpm generate:refractor-languages",
    "dev": "del-cli .next && concurrently \"next dev\" \"pnpm panda:watch\"",
    "dev:e2e": "del-cli .next && concurrently \"cross-env NEXT_PUBLIC_TEST=true next dev\" \"pnpm panda:watch\"",
    "generate:refractor-languages": "node ./scripts/generateRefractorLanguageImports.ts",
    "format": "oxfmt",
    "lint": "oxlint",
    "panda:watch": "panda --watch",
    "prepare": "concurrently \"husky\" \"panda codegen\" \"pnpm generate:refractor-languages\" \"shx mkdir -p public && shx cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/pdf.worker.min.mjs\"",
    "start": "dotenv run -f .env.local -- cross-env HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "test": "cross-env NEXT_PUBLIC_TEST=true vitest run",
    "test:watch": "cross-env NEXT_PUBLIC_TEST=true vitest",
    "update:model-prices": "node ./scripts/updateModelPrices.ts",
    "e2e": "cross-env NODE_ENV=production NEXT_PUBLIC_TEST=true playwright test",
    "e2e:dev": "cross-env NEXT_PUBLIC_TEST=true playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:debug": "cross-env NEXT_PUBLIC_TEST=true playwright test --debug",
    "e2e:ui": "cross-env NEXT_PUBLIC_TEST=true playwright test --ui",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.87",
    "@ai-sdk/openai": "^4.0.101",
    "@ai-sdk/react": "^4.0.154",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@pandacss/dev": "^2.4.0",
    "@sentry/nextjs": "^11.9.0",
    "@tanstack/react-query": "^5.104.5",
    "ai": "^7.0.150",
    "concurrently": "^10.0.6",
    "date-fns": "^4.4.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "jotai": "^3.0.1",
    "lodash-es": "^4.18.1",
    "next": "^16.4.2",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-window": "^2.5.0",
    "refractor": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "superjson": "^2.2.6",
    "use-local-storage-state": "^20.0.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pandacss/preset-base": "^2.4.0",
    "@pandacss/preset-panda": "^2.4.0",
    "@playwright/test": "^1.64.1",
    "@s-h-a-d-o-w/oxlint-config": "^1.9.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "del-cli": "^8.0.1",
    "dotenv": "^18.0.9",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "shx": "^0.4.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
